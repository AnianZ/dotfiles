#!/bin/sh

mrs=$(~/bin/mr-indicator.sh)

while true
do
	time=$(date +"CW %V %a %Y-%m-%d %H:%M:%S")

	bat=$(cat /sys/class/power_supply/BAT0/capacity)

	if [ ! "$(cat /sys/class/power_supply/AC/online)" = "0" ]; then
		bat="🔌${bat}%"
	elif [ "${bat}" -lt 10 ]; then
		bat="⚠️${bat}%"
	else
		bat="🔋${bat}%"
	fi

	# Only do the request every 5 min
	if [ $(( $(date +%s) % 300)) = 0 ]; then
		mrs=$(~/bin/mr-indicator.sh)
	fi

	if [ $(( $(date +%s) % 30)) = 0 ]; then
		ice="$(/home/anian/bin/ice-statusbar)"
	fi

	printf "%s %s %s %s\n" "${ice}" "${time}" "${bat}" "${mrs}"
	sleep 1
done

