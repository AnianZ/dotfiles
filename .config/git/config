[user]
	name = anianz
	email = a.ziegler@cioplenu.de
	signingkey = ~/.ssh/id_ed25519.pub

[core]
	editor = vim
	excludesfile = ~/.config/git/gitignore_global
[push]
	default = current
[pull]
	rebase = true
[rebase]
	autoSquash = true
[alias]
	fuckit = reset --hard
	logt = log --graph --decorate --color=auto --oneline --all
	co = checkout
	br = branch
	c = commit
	st = status
	last = log -1 HEAD
	wip = for-each-ref --sort='authordate:iso8601' --format=' %(color:green)%(authordate:relative)%09%(color:white)%(refname:short)' refs/heads
	pl = pull --autostash
	ps = push -u

[gpg]
	format = ssh
[commit]
	gpgsign = true
